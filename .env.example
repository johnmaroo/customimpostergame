# Create an AI Gateway key at:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional override (default: openai/gpt-5.4-mini)
# IMPOSTER_CLUE_MODEL=openai/gpt-5.4-mini

# Optional public URL for QR / join links (Vercel usually infers this).
# PUBLIC_ORIGIN=https://your-app.vercel.app

# Optional: let a separate existing Vercel frontend call this API.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Where open tables are kept between requests.
#
# Running the game from a laptop needs nothing here: rooms go in the same
# SQLite file as the word bank, so a restart does not close the table.
#
# A serverless deployment does need a shared Redis. Each request can land on a
# different instance, and an instance that goes idle forgets everything it held,
# which is what makes a phone come back to "that room has closed". Connect a
# Redis store in the Vercel dashboard (Storage -> your project) and it sets the
# variables for you; the game picks them up on its own and needs neither of the
# blocks below filled in by hand.
#
# Providers hand out one of two shapes. Whichever you have is enough.
#
# A connection string on its own (Vercel Redis, Redis Cloud):
# REDIS_URL=rediss://default:password@your-store.example:6379
#
# Or REST credentials (Upstash). Preferred when a provider offers both, because
# an HTTPS call holds no socket open per running copy of the app.
# KV_REST_API_URL=https://your-cache.upstash.io
# KV_REST_API_TOKEN=

# Optional: force one backend — memory, sqlite or redis (default: auto).
# IMPOSTER_ROOM_STORE=auto

# Optional: where the SQLite rooms live (default: next to the word bank).
# IMPOSTER_ROOM_DB_PATH=

# Optional: how long a table with nobody looking at it is kept, in seconds
# (default: 14400, four hours). Phones that are polling keep their table alive.
# IMPOSTER_ROOM_TTL_SECONDS=14400

# --- Jeopardy buzzer (/buzzer) ---------------------------------------------
#
# The buzzer keeps its rooms in the same store as the party game, under its
# own keys, so everything above applies to it too and none of it needs
# repeating here. There is no password to set: the host chooses one when they
# open a room, and it is kept as a salted hash.
#
# How long one waiting iPad's request is held open before it is answered with
# no news. It has to stay under the request timeout of whatever is hosting
# this — on Vercel that is the maxDuration in vercel.json (default: 20).
# BUZZER_HOLD_SECONDS=20
#
# How often a waiting request looks in the store for a change some other copy
# of the app made. This is the worst case delay between the host opening the
# buzzers and an iPad finding out, and it only applies to a deployment running
# more than one copy: hosting from a laptop signals waiting iPads directly and
# never waits for this at all.
#
# Lower is fairer and costs more reads. Every waiting device looks on the same
# clock grid rather than on its own schedule, so they all find out together
# (default: 0.25).
# BUZZER_TICK_SECONDS=0.25

# Optional: say whether more than one copy of the app answers the same game,
# for a host we cannot recognise (containers behind a load balancer, say).
# Vercel and other serverless hosts are detected already. When this is on and
# no shared cache is configured, the lobby warns the host that a table can
# close on its own, because each copy would only see its own rooms.
# IMPOSTER_MULTI_INSTANCE=false
