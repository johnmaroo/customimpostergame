# Create an AI Gateway key at:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional override (default: openai/gpt-5.4-mini)
# IMPOSTER_CLUE_MODEL=openai/gpt-5.4-mini

# Optional public URL for QR / join links (Vercel usually infers this).
# PUBLIC_ORIGIN=https://your-app.vercel.app

# Optional: let a separate existing Vercel frontend call this API.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Where open tables are kept between requests.
#
# Running the game from a laptop needs nothing here: rooms go in the same
# SQLite file as the word bank, so a restart does not close the table.
#
# A serverless deployment does need a shared cache. Each request can land on a
# different instance, and an instance that goes idle forgets everything it held,
# which is what makes a phone come back to "session expired". Add an Upstash
# Redis from the Vercel Marketplace (Storage -> Upstash) and it sets these two
# for you; the game picks them up on its own.
# KV_REST_API_URL=https://your-cache.upstash.io
# KV_REST_API_TOKEN=

# Optional: force one backend — memory, sqlite or redis (default: auto).
# IMPOSTER_ROOM_STORE=auto

# Optional: where the SQLite rooms live (default: next to the word bank).
# IMPOSTER_ROOM_DB_PATH=

# Optional: how long a table with nobody looking at it is kept, in seconds
# (default: 14400, four hours). Phones that are polling keep their table alive.
# IMPOSTER_ROOM_TTL_SECONDS=14400

# Optional: say whether more than one copy of the app answers the same game,
# for a host we cannot recognise (containers behind a load balancer, say).
# Vercel and other serverless hosts are detected already. When this is on and
# no shared cache is configured, the lobby warns the host that a table can
# close on its own, because each copy would only see its own rooms.
# IMPOSTER_MULTI_INSTANCE=false
