# Create an AI Gateway key at:
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional override (default: openai/gpt-5.4-mini)
# IMPOSTER_CLUE_MODEL=openai/gpt-5.4-mini

# Optional public URL for QR / join links (Vercel usually infers this).
# PUBLIC_ORIGIN=https://your-app.vercel.app

# Optional: let a separate existing Vercel frontend call this API.
# CORS_ORIGINS=https://your-frontend.vercel.app
